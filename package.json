{
  "name": "agent-connectors",
  "version": "0.2.1",
  "description": "Discover and prepare reusable Node.js connector capabilities.",
  "type": "module",
  "types": "./types/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-connectors": "./bin/agent-connectors.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "bin/",
    "src/",
    "declarations/",
    "types/",
    "schemas/",
    "docs/",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "types:build": "tsc --project tsconfig.declarations.json",
    "types": "npm run types:build && tsc --project tsconfig.json",
    "test": "node --test tests/node/*.test.js",
    "prepack": "npm run types:build",
    "prepublishOnly": "npm run types && npm test",
    "test:postgres": "node --test tests/node/postgres.integration.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
