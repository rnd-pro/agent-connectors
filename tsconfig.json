{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "bin/**/*.js",
    "src/**/*.js",
    "types/**/*.d.ts",
    "tests/**/*.js"
  ]
}
