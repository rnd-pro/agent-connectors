{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "enum": [
        "completed",
        "rejected",
        "unknown"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "value": true,
    "logs": {
      "type": "string",
      "maxLength": 65536
    }
  }
}
