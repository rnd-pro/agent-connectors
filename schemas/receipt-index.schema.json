{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "entries"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "fingerprint",
          "inputDigest",
          "registryId",
          "scope",
          "source",
          "scriptId",
          "revision",
          "grantId",
          "state",
          "createdAt",
          "deadline",
          "ownerPid",
          "token"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "registryId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source": {
            "enum": [
              "cli",
              "agent",
              "agui"
            ]
          },
          "scriptId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "grantId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "state": {
            "enum": [
              "running",
              "completed",
              "rejected",
              "unknown"
            ]
          },
          "createdAt": {
            "type": "number"
          },
          "deadline": {
            "type": "number"
          },
          "ownerPid": {
            "type": "integer",
            "minimum": 1
          },
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
