{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "generation",
    "sources"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "registryId"
        ],
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1
          },
          "registryId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    }
  }
}
